{
  "name": "emg-coach-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "build:g2": "tsc -b && vite build --mode g2 --outDir dist-g2",
    "lint": "oxlint",
    "preview": "vite preview",
    "g2:manifest": "node scripts/g2-manifest.mjs",
    "g2:pack": "npm run build:g2 && evenhub pack app.json dist-g2 -o myocoach-g2.ehpk --sdk-ver 0.0.14",
    "demo": "node scripts/record-demo.mjs demo.mp4 summary.png"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
